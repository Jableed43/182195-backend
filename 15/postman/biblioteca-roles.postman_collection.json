    {
      "name": "1 · Login · guardan el token solos",
      "description": "Correr los tres primero: dejan tokenAna, tokenCarla y tokenAdmin en el environment. APRENDIZAJE: el token se pide una vez y se reusa; el rol ya viaja adentro.",
      "item": [
        {
          "name": "01 · Login Ana (comprador)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// guarda el token en el environment: no hace falta copiar y pegar",
                  "pm.environment.set(\"tokenAna\", pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana.gomez@mail.com\",\n  \"password\": \"ana12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
