# Copiá este archivo como .env:   cp .env.example .env
# El .env NO se sube a git.

# ⚠️ Tiene que incluir /api, que es donde el back monta sus rutas.
#    api.js arma la URL como ${VITE_API_URL}libros
VITE_API_URL=http://localhost:3000/api/

# Si corrés el front con "npm run dev", podés usar esto en un .env.local
# y te lo resuelve el proxy de vite.config.js (no hace falta CORS):
#     VITE_API_URL=/api/

# En Vercel esta variable NO se lee de acá: va en
# Settings → Environment Variables, con la URL del back desplegado:
#     VITE_API_URL=https://tu-back.vercel.app/api/
